# ESP-IDF SDK config for ESP32-S3-BOX-3 voice client
# Ouroboros voice projection device

# Flash — 16MB Quad SPI, 80MHz
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASH_MODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Partition — single large app
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# System
CONFIG_ESP_SYSTEM_EVENT_QUEUE_SIZE=32
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# WiFi buffers
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# PSRAM
CONFIG_SPIRAM=y
CONFIG_ESP32S3_DATA_CACHE_64K=y

# Flash speed
CONFIG_ESPTOOLPY_BAUD_921600B=y

# Audio / LPA (Low Power Audio)
CONFIG_ESP_LPA_SYSTICK_USE_FREERTOS=y
CONFIG_ESP_LPA_TASK_STACK=2048

# HTTP / WebSocket
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_ESP_HTTP_CLIENT持有_BASIC_AUTH=n

# Logging — reduce noise
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL=5
